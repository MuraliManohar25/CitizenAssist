# ===========================
# CitizenAssist — Environment Variables
# ===========================

# --- LLM API Keys (choose one) ---
GOOGLE_API_KEY=your_google_api_key_here

# Optional alternatives (comment out if using Gemini)
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# --- LLM Model Selection ---
# Check Google AI's current models page before changing this value.
LLM_MODEL=gemini-3.5-flash-lite

# --- Embedding Model ---
# Default: all-MiniLM-L6-v2 (lightweight, fast, good quality)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector Store ---
# Path to store/load FAISS index
VECTORSTORE_PATH=./vectorstore

# --- RAG Settings ---
# Top-k chunks to retrieve per query
RAG_TOP_K=5
# Minimum similarity threshold (0-1); below this = "insufficient evidence"
RAG_MIN_SIMILARITY=0.20

# --- App Settings ---
APP_NAME=CitizenAssist
APP_VERSION=1.0.0
DEBUG=false

# --- Optional admin protection ---
# Leave this unset to disable the Admin page in public deployments.
# Store the real value in your host's secret manager, never in version control.
ADMIN_PASSWORD=set_a_strong_unique_password
